<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F8F9FA"
    android:padding="28dp">

    <TextView
        android:id="@+id/txtTimerAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/timer_finished_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtTimerAlertTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="54sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txtTimerAlertName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_timer"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txtTimerAlertMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="18sp"
        android:textStyle="italic"
        android:textColor="#333333"
        android:visibility="gone"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnTimerAlertRestart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_timer_restart_action"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnDismissTimerAlert"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_timer_dismiss_action"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
