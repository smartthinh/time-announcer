<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F8F9FA"
    android:padding="28dp">

    <TextView
        android:id="@+id/txtAlertHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_alert_header"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtAlertTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="54sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtAlertMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="20sp"
        android:textStyle="italic"
        android:textColor="#333333"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtAlertSnoozeInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="15sp"
        android:textColor="#757575"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnAlertSnooze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/alarm_btn_snooze"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAlertDismiss"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/alarm_btn_dismiss"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
