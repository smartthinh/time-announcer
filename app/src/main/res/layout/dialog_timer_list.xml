<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Multi-select Action Bar -->
    <LinearLayout
        android:id="@+id/llTimerMultiSelectActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnSelectAllTimers"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_select_all"
            android:textSize="12sp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnEditSelectedTimer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_edit_timer"
            android:textSize="12sp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDeleteSelectedTimers"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_delete"
            android:textSize="12sp"
            android:textColor="#D32F2F"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnCancelMultiSelectTimers"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textSize="12sp"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- Normal Action: Create Timer Button -->
    <Button
        android:id="@+id/btnCreateTimer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_create_timer"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txtEmptyTimers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="28dp"
        android:text="@string/timer_list_empty"
        android:textSize="15sp"
        android:textColor="#666666"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollTimers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="340dp">

        <LinearLayout
            android:id="@+id/llTimerListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseTimerList"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_close"
        android:textSize="15sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
