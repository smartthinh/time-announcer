<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hour and Minute Inputs with inline hints -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/edtAlarmHour"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="@string/hint_hour"
                android:inputType="number"
                android:maxLength="2"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : "
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/edtAlarmMinute"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="@string/hint_minute"
                android:inputType="number"
                android:maxLength="2"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Snooze Repeat Count with inline hint -->
        <EditText
            android:id="@+id/edtSnoozeCount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_snooze_count"
            android:inputType="number"
            android:maxLength="2"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- Snooze Interval Minutes with inline hint -->
        <EditText
            android:id="@+id/edtSnoozeInterval"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_snooze_interval"
            android:inputType="number"
            android:maxLength="3"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- TTS Message with inline hint -->
        <EditText
            android:id="@+id/edtAlarmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_alarm_message"
            android:inputType="textCapSentences|textMultiLine"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- Days of week button -->
        <Button
            android:id="@+id/btnAlarmDays"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/alarm_btn_days"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Sound CheckBox -->
        <CheckBox
            android:id="@+id/chkAlarmSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chk_alarm_sound"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Ringtone button (shown only if chkAlarmSound is checked) -->
        <Button
            android:id="@+id/btnAlarmRingtone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/alarm_btn_ringtone"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Vibrate CheckBox -->
        <CheckBox
            android:id="@+id/chkAlarmVibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chk_alarm_vibrate"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
