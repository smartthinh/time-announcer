<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_dialog_time_header"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Hour and Minute Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/edtAlarmHour"
                android:layout_width="80dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:hint="00"
                android:inputType="number"
                android:maxLength="2"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : "
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/edtAlarmMinute"
                android:layout_width="80dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:hint="00"
                android:inputType="number"
                android:maxLength="2"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Snooze Repeat Count -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_repeat_count_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtSnoozeCount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="3"
            android:inputType="number"
            android:maxLength="2"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- Snooze Interval Minutes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_snooze_interval_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtSnoozeInterval"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="5"
            android:inputType="number"
            android:maxLength="3"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- TTS Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_message_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtAlarmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/alarm_message_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- Days of week button -->
        <Button
            android:id="@+id/btnAlarmDays"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/alarm_btn_days"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Ringtone button -->
        <Button
            android:id="@+id/btnAlarmRingtone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/alarm_btn_ringtone"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
